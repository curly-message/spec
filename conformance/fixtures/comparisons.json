      },
      "expected": {
        "output": "X"
      }
    },
    {
      "id": "comparisons/gte-equality-case-insensitive",
      "description": "The equality leg of gte compares case-insensitively.",
      "section": "11.1",
      "message": "{{v:gte; ABC:X; default:D}}",
      "payload": {
        "v": "abc"
      },
      "expected": {
        "output": "X"
      }
    },
