        "v": 1
      },
      "expected": {
        "output": "FIVE"
      }
    },
    {
      "id": "comparisons/gt-skips-non-numeric-key",
      "description": "An option whose key is not numeric is never selected by gt, and the numeric keys around it are ordered.",
      "section": "11.1",
      "message": "{{v:gt; 5:FIVE; abc:ABC; 10:TEN; default:D}}",
