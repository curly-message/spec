      },
      "expected": {
        "output": "D"
      }
    },
    {
      "id": "comparisons/gte-equal-key-selects",
      "description": "gte selects an option whose key equals the value.",
      "section": "11.1",
      "message": "{{v:gte; 1:VALUE1; 10:VALUE2; default:D}}",
