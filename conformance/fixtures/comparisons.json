      "message": "{{v:gte; abc:X; 5:FIVE; default:D}}",
      "payload": {
        "v": "abc"
      },
      "expected": {
        "output": "X"
      }
    },
    {
      "id": "comparisons/lte-equality-case-insensitive",
      "description": "The equality leg of lte compares case-insensitively.",
