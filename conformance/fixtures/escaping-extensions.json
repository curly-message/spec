{
  "format": "curly-message-3",
  "level": "extensions",
  "section": "7",
  "cases": [
    {
      "id": "escaping-extensions/modifier-name-colon",
      "description": "A modifier name carries a colon as an escape sequence and is matched after unescaping.",
      "section": "7",
      "message": "{{v:x-a\\:b}}",
      "payload": {
        "v": "hit"
      },
      "modifiers": {
        "x-a:b": "upper"
      },
      "expected": {
        "output": "HIT"
      }
    },
    {
      "id": "escaping-extensions/modifier-name-escaped-space",
      "description": "A space an escape sequence claims is part of the modifier name and is matched with it.",
      "section": "7",
      "message": "{{v:x-c\\ }}",
      "payload": {
        "v": "hit"
      },
      "modifiers": {
        "x-c ": "upper"
      },
      "expected": {
        "output": "HIT"
      }
    },
    {
      "id": "escaping-extensions/modifier-name-keeps-colons",
      "description": "Only the first unescaped colon of the selector separates the key from the modifier name, so a later one needs no escape.",
      "section": "6",
      "message": "{{v:x-a:b}}",
      "payload": {
        "v": "hit"
      },
      "modifiers": {
        "x-a:b": "upper"
      },
      "expected": {
        "output": "HIT"
      }
    },
    {
      "id": "escaping-extensions/modifier-answer-not-unescaped",
      "description": "A modifier answers with the placeholder's result, which is data: the serialization it was handed reaches the output as the conversion made it.",
      "section": "5",
      "message": "{{v:echo}}",
      "payload": {
        "v": {
          "a": "x\\:"
        }
      },
      "modifiers": {
        "echo": "echo"
      },
      "expected": {
        "output": "{\"a\":\"x\\\\:\"}"
      }
    },
    {
      "id": "escaping-extensions/options-handed-unescaped",
      "description": "A host-defined modifier is handed an option key and an option value both unescaped, because an option value is the message's own text; what it answers with is data and is not unescaped again.",
      "section": "7",
      "message": "{{v:opts; a\\\\\\\\b}}",
      "payload": {
        "v": "x"
      },
      "modifiers": {
        "opts": "options"
      },
      "expected": {
        "output": "a\\\\b=a\\\\b"
      }
    }
  ]
}
